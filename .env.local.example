# ─────────────────────────────────────────────────────────────────────────────
#  GigNest environment
#
#  Copy this file to `.env.local` and fill it in:
#      cp .env.local.example .env.local
#
#  With NO .env.local present the app boots in DEMO MODE — seeded fake gigs,
#  no login. That's intentional so you can see the UI immediately.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# `URL` and `anon key` are safe to expose to the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ⚠️  SERVER ONLY. Bypasses every Row Level Security policy you have.
# Used exclusively by the admin panel. Never prefix it with NEXT_PUBLIC_,
# never commit it, and rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Admin panel ─────────────────────────────────────────────────────────────
# The password you type at /admin/login.
ADMIN_PASSWORD=change-me-before-you-demo

# Signs the admin session cookie. Generate a real one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=generate-a-long-random-string-here

# ── Free AI skill coach ─────────────────────────────────────────────────────
# Server only. Powers /learn — the coach that turns a skill into a 5-step plan.
# Free tier: no card needed. Without it /learn falls back to a built-in plan.
#     https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR-GEMINI-KEY

# ── App ─────────────────────────────────────────────────────────────────────
# Used to build the OAuth redirect URL. Locally leave as-is; on Vercel set this
# to your real domain, e.g. https://gignest.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
